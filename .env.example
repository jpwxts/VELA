# Copy this file to .env and fill in the key there.
# Do not paste the key into chat, the frontend, or Git.
#
# Request a free key:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Earthdata Login is stored by `earthaccess login` in your home .netrc.
# Do not put your Earthdata password in this file.

# Preparedness briefs are sent only after you review the draft,
# and only to this inbox. Leave these blank to keep drafts on screen.
BRIEF_TEST_INBOX=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
